# Copier ce fichier en .env sur le serveur (jamais commité dans git) et remplir les valeurs réelles.

# --- Base de données PostgreSQL locale sur le VPS ---
DATABASE_URL="postgresql://holisya_user:CHANGE_ME@localhost:5432/holisya?schema=public"

# --- NextAuth ---
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_-base64_32"
NEXTAUTH_URL="https://holisya.walautao.fr"

# --- Stripe (clés live) ---
STRIPE_PUBLISHABLE_KEY="pk_live_xxx"
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- SMTP (envoi d'emails) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="contact@holisya.fr"
SMTP_PASSWORD="CHANGE_ME"
SMTP_FROM="\"Holisya\" <contact@holisya.fr>"

# --- Avis Google (fiche Google Business) ---
GOOGLE_REVIEW_URL="https://maps.app.goo.gl/A77YK4F4it5FHom37"
